* {
  font-family: "JetBrains Mono", monospace;
  font-size: 13px;
  border: none;
  border-radius: 0;
  min-height: 0;
  box-shadow: none;
  text-shadow: none;
}

window#waybar {
  background: #000000;
  color: #ff2a2a;
}

#workspaces button {
  padding: 0 8px;
  color: #8a8a8a;
  background: transparent;
}

#workspaces button.active {
  background: #ff2a2a;
  color: #000000;
}

#workspaces button:hover {
  background: #1a1a1a;
  color: #ff2a2a;
}

#custom-ctos,
#cpu,
#memory,
#temperature,
#network,
#custom-uptime,
#clock {
  padding: 0 4px;
  color: #ff2a2a;
  background: transparent;
}
