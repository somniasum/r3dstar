{
  "layer": "top",
  "position": "top",
  "height": 22,
  "spacing": 0,
  "reload_style_on_change": false,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [
    "custom/ctos",
    "cpu",
    "memory",
    "temperature",
    "network#io",
    "network#vpn",
    "custom/uptime",
    "clock"
  ],
  "modules-right": [],

  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": { "*": 9 },
    "disable-scroll": true
  },

  "custom/ctos": {
    "exec": "echo ctOS",
    "interval": "once",
    "format": "[ {} ]"
  },

  "cpu": {
    "interval": 2,
    "format": "[ cpu {usage}% ]"
  },

  "memory": {
    "interval": 3,
    "format": "[ ram {percentage}% ]"
  },

  "temperature": {
    "interval": 3,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "[ {temperatureC}C ]"
  },

  "network#io": {
    "interval": 2,
    "format": "[ rx {bandwidthDownBytes} tx {bandwidthUpBytes} ]",
    "format-disconnected": "[ rx -- tx -- ]"
  },

  "network#vpn": {
    "interface": "tun0",
    "interval": 5,
    "format": "[ vpn {ipaddr} ]",
    "format-disconnected": "[ vpn -- ]"
  },

  "custom/uptime": {
    "exec": "$HOME/.config/hypr/scripts/uptime",
    "interval": 30,
    "format": "[ up {} ]"
  },

  "clock": {
    "interval": 30,
    "format": "[ {:%a %d %b %H:%M} ]"
  }
}
