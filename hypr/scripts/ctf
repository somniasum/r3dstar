#!/bin/bash
# ctf <name> [target-ip]: set up ~/ctf/<name> and open a tmux workspace for it.
# Windows: exploit, shell, notes. Every pane gets CTF, LHOST and TARGET set.
# Re-running with the same name re-attaches to the same session.
name=${1:?usage: ctf <name> [target-ip]}
target=${2:-}
dir="$HOME/ctf/$name"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

mkdir -p "$dir"/{notes,exploit,loot,bin}
if [ ! -f "$dir/notes/README.md" ]; then
    printf '# %s\n\ntarget: %s\n\n## recon\n\n## foothold\n\n## privesc\n' \
        "$name" "${target:-?}" >"$dir/notes/README.md"
fi

lhost=$("$here/lhost" -p 2>/dev/null)
env_args=(-e "CTF=$name" -e "LHOST=${lhost:-}")
[ -n "$target" ] && env_args+=(-e "TARGET=$target")

if ! tmux has-session -t "$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -n exploit -c "$dir/exploit" "${env_args[@]}"
    tmux new-window -t "$name" -n shell -c "$dir" "${env_args[@]}"
    tmux new-window -t "$name" -n notes -c "$dir/notes" "${env_args[@]}" "${EDITOR:-vim} README.md"
    tmux select-window -t "$name:exploit"
fi

exec ghostty -e tmux attach -t "$name"
