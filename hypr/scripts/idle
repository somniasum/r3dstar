#!/bin/sh
# idle: lock the screen after 15 minutes without input, and before suspend.
# Fullscreen windows (games, video) keep it awake. Game mode stops this (Super+F10).
command -v swayidle >/dev/null && command -v swaylock >/dev/null || exit 0
pgrep -x swayidle >/dev/null && exit 0
dir=$(dirname "$(readlink -f "$0")")
exec swayidle -w timeout 900 "$dir/lock" before-sleep "$dir/lock"
