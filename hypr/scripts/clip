#!/bin/sh
# clip: pick something from your clipboard history (cliphist) and copy it again.
# clip wipe: delete the whole history. Do this after copying secrets.
command -v cliphist >/dev/null || { echo "cliphist is not installed" >&2; exit 1; }

if [ "${1:-}" = "wipe" ]; then
    cliphist wipe
    command -v notify-send >/dev/null && notify-send -t 1500 "Clipboard history wiped"
    exit 0
fi

sel=$(cliphist list | fuzzel --dmenu --prompt 'clip> ') || exit 0
printf '%s' "$sel" | cliphist decode | wl-copy
