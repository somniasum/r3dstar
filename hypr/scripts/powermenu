#!/bin/sh
# powermenu: lock, logout, suspend, reboot or shutdown from a launcher list
dir=$(dirname "$(readlink -f "$0")")
choice=$(printf 'lock\nlogout\nsuspend\nreboot\nshutdown\n' | fuzzel --dmenu --lines 5 --width 20 --prompt 'power> ') || exit 0
case "$choice" in
lock) exec "$dir/lock" ;;
logout) hyprctl dispatch 'hl.dsp.exit()' ;;
suspend) systemctl suspend ;;
reboot) systemctl reboot ;;
shutdown) systemctl poweroff ;;
esac
