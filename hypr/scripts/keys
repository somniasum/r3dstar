#!/bin/sh
# keys [--print]: searchable cheat sheet of every keybind that has a description.
# The list comes straight from Hyprland (hyprctl binds), so it always matches your config.
list=$(hyprctl binds -j 2>/dev/null | jq -r '
  def on(m; b): ((m / b | floor) % 2) == 1;
  def mods(m): [ (if on(m; 64) then "Super" else empty end),
                 (if on(m; 4)  then "Ctrl"  else empty end),
                 (if on(m; 8)  then "Alt"   else empty end),
                 (if on(m; 1)  then "Shift" else empty end) ];
  def pretty($k): ({"grave": "`", "slash": "/", "Return": "Enter", "Escape": "Esc",
                    "space": "Space", "mouse:272": "LMB drag", "mouse:273": "RMB drag"}[$k]) // $k;
  .[] | select((.description // "") != "")
      | ((mods(.modmask // 0) + [pretty(.key)]) | join("+")) as $combo
      | (if (.submap // "") != "" then "[" + .submap + "] " else "" end) + $combo + "\t" + .description
') || list=""

if [ -z "$list" ]; then
    echo "no described keybinds found (is Hyprland running?)" >&2
    exit 1
fi

table=$(printf '%s\n' "$list" | awk -F'\t' '{ printf "%-26s %s\n", $1, $2 }')

if [ "${1:-}" = "--print" ]; then
    printf '%s\n' "$table"
else
    printf '%s\n' "$table" | fuzzel --dmenu --prompt 'keys> ' --width 64 --lines 22 >/dev/null
fi
