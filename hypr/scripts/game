#!/bin/sh
# game on|off: strip the desktop down while you play (called by Super+F10)
case "${1:-}" in
on)
    pkill -x waybar
    command -v makoctl >/dev/null && makoctl mode -a dnd
    command -v powerprofilesctl >/dev/null && powerprofilesctl set performance 2>/dev/null
    ;;
off)
    command -v makoctl >/dev/null && makoctl mode -r dnd
    command -v powerprofilesctl >/dev/null && powerprofilesctl set balanced 2>/dev/null
    pgrep -x waybar >/dev/null || setsid -f waybar >/dev/null 2>&1
    ;;
*)
    echo "usage: game on|off" >&2
    exit 2
    ;;
esac
exit 0
